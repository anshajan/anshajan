# ---------------------------------------------------------------------------
# anshaj — environment configuration
# Copy to .env.local and fill in. Nothing in this file is ever sent to the
# browser: every key here is read only inside server-side code (API routes,
# proxy.ts) — see lib/openai.ts, lib/gemini.ts, lib/pinterest.ts, none of
# which are "use client" modules.
# Leave every AI/Pinterest key below unset to run in DEMO MODE — the app
# automatically simulates the full pipeline with realistic fixtures.
# ---------------------------------------------------------------------------

# --- AI provider (pick ONE; Gemini is used first if both are set) ---
# Google Gemini (https://aistudio.google.com/apikey) — used for keyword
# extraction, vision style analysis, AND image generation (Gemini's native
# image-output models, aka "Nano Banana"). IMPORTANT: Google's free tier
# does not include image-output models at all (verified: every image model
# returns 429 "limit: 0" on free tier) — you need a Google Cloud project
# with billing enabled linked to this key for poster generation to work.
# Text/vision calls do work on the free tier.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-flash-lite-latest
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# OpenAI (GPT-4o-mini for keywords, GPT-4o Vision for analysis, DALL-E 3 for
# generation) — used only if GEMINI_API_KEY is unset.
OPENAI_API_KEY=

# --- Pinterest API v5 (https://developers.pinterest.com) ---
# Pinterest references are an enrichment, not the core feature: any
# Pinterest API failure other than rate-limiting (expired/unapproved app,
# wrong scope, network error) falls back to demo references automatically
# rather than breaking poster generation — see lib/pinterest.ts. A fresh
# Pinterest app commonly returns 401 "Your application consumer type is
# not supported" on every v5 endpoint, including the most basic one, until
# Pinterest approves it for live API access in the Developer Portal.
PINTEREST_ACCESS_TOKEN=
PINTEREST_API_BASE=https://api.pinterest.com/v5

# --- Supabase (auth, credits, saved posters) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (subscription billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_CREATOR=
NEXT_PUBLIC_STRIPE_PRICE_AGENCY=

# --- App / security ---
# This deployment's own origin (prod, preview, or custom domain) is ALWAYS
# allowed to call its own /api/* automatically, with no config needed — see
# lib/security/headers.ts. Only set this for ADDITIONAL, separate origins
# (e.g. a different marketing site) that need to call this API cross-site.
# Comma-separated list of origins allowed to call /api/* (CORS allowlist).
ALLOWED_ORIGINS=http://localhost:3000
# Secret used to sign short-lived internal session/credit tokens.
APP_JWT_SECRET=dev-only-change-me
# Upstash Redis (optional). If unset, rate limiting falls back to an
# in-memory token bucket, which is fine for a single server instance but
# does not share state across multiple instances/regions.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
