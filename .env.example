# ---------------------------------------------------------------------------
# anshaj — environment configuration
# Copy to .env.local and fill in. Nothing in this file is ever sent to the
# browser: every key here is read only inside server-side code (API routes,
# middleware). See lib/security/env.ts for the enforcement of that boundary.
# Leave OPENAI_API_KEY / PINTEREST_ACCESS_TOKEN unset to run in DEMO MODE —
# the app automatically simulates the full pipeline with realistic fixtures.
# ---------------------------------------------------------------------------

# --- OpenAI (GPT-4o Vision for analysis, DALL-E 3 for generation) ---
OPENAI_API_KEY=

# --- Pinterest API v5 (https://developers.pinterest.com) ---
PINTEREST_ACCESS_TOKEN=
PINTEREST_API_BASE=https://api.pinterest.com/v5

# --- Supabase (auth, credits, saved posters) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (subscription billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_CREATOR=
NEXT_PUBLIC_STRIPE_PRICE_AGENCY=

# --- App / security ---
# This deployment's own origin (prod, preview, or custom domain) is ALWAYS
# allowed to call its own /api/* automatically, with no config needed — see
# lib/security/headers.ts. Only set this for ADDITIONAL, separate origins
# (e.g. a different marketing site) that need to call this API cross-site.
# Comma-separated list of origins allowed to call /api/* (CORS allowlist).
ALLOWED_ORIGINS=http://localhost:3000
# Secret used to sign short-lived internal session/credit tokens.
APP_JWT_SECRET=dev-only-change-me
# Upstash Redis (optional). If unset, rate limiting falls back to an
# in-memory token bucket, which is fine for a single server instance but
# does not share state across multiple instances/regions.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
